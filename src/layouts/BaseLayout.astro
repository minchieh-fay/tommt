---
const { title = 'TOMMT', description = '文章列表' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">TOMMT</a>
    </header>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} TOMMT</footer>
  </body>
</html>

<style is:global>
  :root { font-family: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #202124; background: #fafaf9; }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; }
  .site-header, main, footer { width: min(760px, calc(100% - 40px)); margin-inline: auto; }
  .site-header { padding: 28px 0 22px; border-bottom: 1px solid #e4e4e1; }
  .brand { color: #202124; font-size: 15px; font-weight: 700; letter-spacing: .08em; text-decoration: none; }
  main { min-height: calc(100vh - 130px); }
  footer { padding: 28px 0 34px; color: #8a8a84; font-size: 12px; }
  @media (max-width: 600px) { .site-header, main, footer { width: min(100% - 28px, 760px); } .site-header { padding-top: 22px; } }
</style>
